import("//ui/webui/resources/tools/build_webui.gni")

# Enroll page (teleport://enroll -> chrome://enroll) resources: a Lit
# (cr-elements) app, TS-compiled + grit-packed via the standard WebUI pipeline.
# Generates the enroll_resources map consumed by
# //chrome/browser/ui/webui:teleport_enroll.
build_webui("build") {
  grd_prefix = "enroll"

  static_files = [ "enroll.html" ]

  css_files = [ "enroll_app.css" ]

  ts_files = [
    "enroll.ts",
    "enroll_app.ts",
    "enroll_app.html.ts",
  ]

  mojo_files_deps =
      [ "//chrome/browser/ui/webui:teleport_enroll_mojo_ts__generator" ]
  mojo_files =
      [ "$root_gen_dir/teleport/browser/webui/enroll.mojom-webui.ts" ]

  ts_composite = true

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_components/color_change_listener:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  webui_context_type = "trusted"
}
