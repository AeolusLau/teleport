# Official channel build args for the teleport overlay on macOS (Apple Silicon).
# Distinct out dir from dev (out/mac/arm64/release). One build serves all
# channels; channel identity (feed URL / bundle id) is applied at packaging
# time by scripts/package.py — see the canary channel spec §3.4.
target_os = "mac"
target_cpu = "arm64"

is_debug = false
is_official_build = true
is_component_build = false
use_remoteexec = false

# Profile-guided optimization, so canary runtime perf tracks the production
# config (PGO is the main perf gap between an official no-PGO build and shipping
# Chrome). is_official_build defaults this to 2 on mac; set explicitly for
# clarity. phase=2 hard-requires two profile sets in the checkout: the Chrome PGO
# profile (chrome/build/pgo_profiles/, asserted at `gn gen`) and the V8 builtins
# PGO profile (v8/tools/builtins-pgo/profiles/, a mksnapshot build input). Both
# are fetched by `gclient sync` via chromium's DEPS hooks, enabled by the
# checkout_pgo_profiles=True custom_var that bootstrap.py writes into .gclient.
chrome_pgo_phase = 2

# Enable the Sparkle auto-updater (compiles browser/mac/teleport_updater.mm and
# links Sparkle.framework; requires `python scripts/fetch_sparkle.py` first).
teleport_enable_updater = true

# Light the toolbar/app-menu "update ready -- relaunch" indicator. Upstream gates
# this behind is_chrome_branded (//chrome/browser/buildflags.gni:
# enable_update_notifications = is_chrome_branded) because stock Chromium ships
# no updater. Our build DOES (Sparkle): without this flag, UpgradeDetectorImpl
# never registers as a BuildState observer, so the teleport_update_buildstate
# bridge's BuildState::SetUpdate() has no effect and the app-menu upgrade badge
# can never light. Verified via A/B probe: flag off -> SetUpdate leaves the
# detector at stage NONE; flag on -> the stage tracks the update.
enable_update_notifications = true

# Proprietary / platform audio-video codecs (same rationale as dev.mac.gn).
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_hevc_parser_and_hw_decoder = true
enable_platform_dolby_vision = true
enable_platform_ac3_eac3_audio = true
enable_platform_ac4_audio = true
enable_platform_dts_audio = true
enable_platform_mpeg_h_audio = true

# Pin every base::Feature to its compiled default: disable the compiled-in
# fieldtrial_testing_config (the only field-trial source for an unbranded build,
# which fetches no variations seed). Keeps distributed channels free of
# unexpected experiments. Independent of channel (channel only filters seed
# studies, of which we have none).
disable_fieldtrial_testing_config = true

# Bake the production douan.cn enterprise endpoints (DM/enroll/register-handler
# URLs + the kReleasePolicyKey KMS verification root) into the binary. All
# release channels (canary/beta/stable) share these values.
# NOTE: The current kReleasePolicyKey is a throwaway placeholder — teleport.gni's
# fail-closed assert blocks this build until the real production KMS root public
# key DER is vendored. The private key is never committed to the repo.
teleport_deployment_env = "release"
