# Dev build args for the teleport overlay on macOS (Apple Silicon).
# Fast iteration: release-ish + component build + minimal symbols.
target_os = "mac"
target_cpu = "arm64"

is_debug = false
is_component_build = true
symbol_level = 1
blink_symbol_level = 0
v8_symbol_level = 0

is_official_build = false
use_remoteexec = false

# Match release.mac.gn: enable the toolbar/app-menu update indicator so dev can
# exercise it (e.g. --simulate-upgrade / --simulate-critical-update, which drive
# the InstalledVersionPoller gated behind this flag). Upstream defaults it to
# is_chrome_branded=false; we override because our product ships an updater.
# Dev has teleport_enable_updater=false (no Sparkle), so the live Sparkle bridge
# is inert here, but the BuildState->UpgradeDetector->menu path is testable.
enable_update_notifications = true

# Upstream Blink ships a shape-cache consistency self-check behind
# EXPENSIVE_DCHECKS (ng_shape_cache.h, upstream crbug.com/486945341) that
# false-fires on CJK text with font fallback and aborts the renderer
# ("Aw, Snap") on pages like baidu.com. is_official_build=false otherwise
# defaults enable_expensive_dchecks to true. Drop only the expensive
# verification class here; regular DCHECKs stay on. Not an overlay bug, and
# absent from official builds (which build with enable_expensive_dchecks=false).
enable_expensive_dchecks = false

# Proprietary / platform audio-video codecs. proprietary_codecs enables
# Chromium's gated codec paths; ffmpeg_branding="Chrome" ships the bundled
# FFmpeg with the proprietary decoders (H.264/AVC, AAC, MP3). The enable_platform_*
# flags add demuxing + platform (VideoToolbox/AudioToolbox) decode for the rest.
# Patent-encumbered — enabled deliberately for this product.
# Note (macOS): H.264, HEVC, Dolby Vision (HEVC-based), and AC-3/E-AC-3 actually
# decode via VideoToolbox/AudioToolbox; DTS/AC-4/MPEG-H are demuxed but the OS
# may lack a decoder, so those can still fail to play at runtime on macOS.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_hevc_parser_and_hw_decoder = true  # H.265/HEVC (default-true on macOS; explicit)
enable_platform_dolby_vision = true       # Dolby Vision (requires HEVC)
enable_platform_ac3_eac3_audio = true     # Dolby Digital AC-3 / E-AC-3
enable_platform_ac4_audio = true          # Dolby AC-4
enable_platform_dts_audio = true          # DTS / DTS-X
enable_platform_mpeg_h_audio = true       # MPEG-H 3D Audio

# Pin every base::Feature to its compiled default (see release.mac.gn). Also
# permanently fixes the UsePersistentCacheForCodeCache renderer abort: dev runs
# no longer need --disable-field-trial-config (passing it becomes a no-op).
disable_fieldtrial_testing_config = true

# Bake the dev enterprise endpoints (fairyland.io DM/enroll/register-handler
# URLs + kDevPolicyKey verification root) into the binary. See teleport.gni for
# the other two environments; staging.mac.gn and release.mac.gn select those.
teleport_deployment_env = "dev"
