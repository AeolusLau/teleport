# The //teleport additive module, compiled into chrome via a minimal upstream
# BUILD.gn dep patch (see patches/). A standalone test() target keeps unit
# tests buildable without patching upstream test targets.
import("//build/buildflag_header.gni")
import("//teleport/teleport.gni")
import("//testing/test.gni")
import("//third_party/protobuf/proto_library.gni")

# The Chrome framework links Sparkle via @rpath but ships with no LC_RPATH of
# its own. Add one resolving @rpath to the app's Contents/Frameworks (where
# Sparkle.framework sits), relative to the framework binary at
# Frameworks/<Name>.framework/Versions/<V>/<Name>. Applied via
# all_dependent_configs so it lands on the chrome framework's link; the same
# rpath landing on the thin exe/helpers is harmless (they don't load Sparkle).
config("sparkle_rpath") {
  ldflags = [ "-Wl,-rpath,@loader_path/../../.." ]
}

# Leaf buildflag header that bakes the deployment-environment selection into the
# binary at compile time (policy verification root key(s), default DM server URL,
# enroll / register-handler URLs). Kept as a separate target (not part of
# :teleport) so that //components/policy can dep on it without pulling in
# //content and creating a dependency cycle.
buildflag_header("teleport_policy_buildflags") {
  header = "teleport_policy_buildflags.h"

  # Three booleans rather than one string: BUILDFLAG() values are consumed by
  # #if, and the preprocessor cannot compare strings. (buildflag_header itself
  # does support string values — see build/buildflag_header.gni — they are just
  # unusable in the conditional we need.) dev is the both-false case.
  flags = [
    "TELEPORT_ENV_IS_RELEASE=$teleport_env_is_release",
    "TELEPORT_ENV_IS_STAGING=$teleport_env_is_staging",
    "TELEPORT_ALLOWS_DOMAIN_OVERRIDE=$teleport_allows_domain_override",
  ]
}

# Client mirror of fairyland's teleport.v1.ServerIdentityData (proto3),
# wire-compatible by field number + type. Kept as its own target so ONLY the
# heavier server-identity verification lib depends on protobuf — never the
# //base+//url teleport_deployment_config leaf (which //components/policy
# consumes; a proto/policy dep there would reintroduce the dependency cycle).
# proto_out_dir pins the generated header to teleport/common/server_identity.pb.h.
proto_library("server_identity_proto") {
  sources = [ "common/server_identity.proto" ]
  proto_in_dir = "//teleport/common"
  proto_out_dir = "teleport/common"
  cc_generator_options = "lite=true:"
}

# Server-identity verification lib. Heavier than the deployment-config leaf (deps
# //crypto + the proto); the level-4 caller (Phase 2b, in //chrome/browser)
# injects the baked root key DER, so this lib never touches //components/policy or
# Local State. Kept separate from the leaf to preserve the no-cycle guarantee.
source_set("teleport_server_identity") {
  sources = [
    "common/teleport_server_identity.cc",
    "common/teleport_server_identity.h",
  ]
  deps = [
    ":server_identity_proto",
    "//base",
    "//crypto",
  ]
}

# Minimal-dependency deployment-domain resolver + endpoint derivation. Deps only
# //base + //url (NOT //content), so //components/policy (browser_policy_connector)
# can consume the derived endpoints without a dependency cycle on :teleport —
# mirroring the teleport_policy_buildflags isolation above.
source_set("teleport_deployment_config") {
  sources = [
    "common/teleport_deployment_config.cc",
    "common/teleport_deployment_config.h",
  ]
  deps = [
    ":teleport_policy_buildflags",
    "//base",
    "//url",
  ]
  if (is_mac) {
    sources += [ "common/teleport_deployment_config_mac.mm" ]
  }
}

# Pure routing/config logic split out of teleport_tunnel_service.{h,cc} so it is
# unit-testable outside the monolithic chrome/browser (TD-TUNNEL-UNITTEST-WIRING).
# The tunnel service .cc is compiled INTO chrome/browser via the patch and calls
# these free functions; :teleport re-exports this target (public_deps below), and
# chrome/browser — which already deps //teleport — links it transitively, so no
# chrome/browser BUILD.gn.patch change is needed. Deps are deliberately light
# (//base + //net + //services/network mojom + //url); no //content, no
# //chrome/browser — which is exactly what keeps it linkable by teleport_unittests.
source_set("teleport_tunnel_logic") {
  sources = [
    "browser/enterprise/teleport_tunnel_logic.cc",
    "browser/enterprise/teleport_tunnel_logic.h",
  ]
  public_deps = [
    "//base",
    "//services/network/public/mojom",
  ]
  deps = [
    "//net",
    "//url",
  ]
}

source_set("teleport") {
  sources = [
    "browser/enterprise/teleport_inplace_enrollment_sequence.cc",
    "browser/enterprise/teleport_inplace_enrollment_sequence.h",
    "browser/teleport_startup.cc",
    "browser/teleport_startup.h",
    "common/teleport_channel.cc",
    "common/teleport_channel.h",
    "common/teleport_enroll_logic.cc",
    "common/teleport_enroll_logic.h",
    "common/teleport_domain_migration.cc",
    "common/teleport_domain_migration.h",
    "common/teleport_enrollment_gate_logic.cc",
    "common/teleport_enrollment_gate_logic.h",
    "common/teleport_signin_entry_logic.cc",
    "common/teleport_signin_entry_logic.h",
    "common/teleport_enterprise_enrollment.cc",
    "common/teleport_enterprise_enrollment.h",
    "common/teleport_server_identity_entry.cc",
    "common/teleport_server_identity_entry.h",
    "common/teleport_enterprise_urls.cc",
    "common/teleport_enterprise_urls.h",
    "common/teleport_feed_url.cc",
    "common/teleport_feed_url.h",
    "common/teleport_pref_names.cc",
    "common/teleport_pref_names.h",
    "common/teleport_url_scheme.cc",
    "common/teleport_url_scheme.h",
    "common/teleport_version.cc",
    "common/teleport_version.h",
  ]
  # teleport_tunnel_logic is re-exported so chrome/browser (which deps //teleport
  # and compiles teleport_tunnel_service.cc via the patch) links the tunnel free
  # functions transitively — no chrome/browser BUILD.gn.patch change needed.
  public_deps = [
    ":teleport_tunnel_logic",
    "//components/version_info",
  ]
  deps = [
    ":teleport_deployment_config",
    ":teleport_server_identity",
    "//base",
    "//content/public/common",
    "//url",
  ]
  if (is_mac) {
    # Always expose the updater entry points so app_controller_mac.mm can call
    # them unconditionally. With the updater on, the real Sparkle-backed .mm is
    # built; otherwise a no-op stub keeps dev builds free of Sparkle.
    sources += [ "browser/mac/teleport_updater.h" ]
    sources += [ "common/teleport_channel_mac.mm" ]
    if (teleport_enable_updater) {
      sources += [
        "browser/mac/teleport_sparkle_user_driver.h",
        "browser/mac/teleport_sparkle_user_driver.mm",
        "browser/mac/teleport_updater.mm",
      ]

      # Set Sparkle link settings DIRECTLY on the source_set, NOT via
      # all_dependent_configs: that propagates along every dep edge (including
      # bundle_data) and leaked -framework Sparkle into the thin main executable,
      # tripping verify_dynamic_libraries. As target link settings,
      # framework_dirs/frameworks flow only to the binary that links these
      # objects (chrome_framework), not to the exe that merely bundles it.
      # framework_dirs also gives -F for the .mm compile (<Sparkle/Sparkle.h>).
      framework_dirs = [ teleport_sparkle_dir ]
      frameworks = [ "Sparkle.framework" ]
      all_dependent_configs = [ ":sparkle_rpath" ]
    } else {
      sources += [ "browser/mac/teleport_updater_stub.cc" ]
    }
  }
}

test("teleport_unittests") {
  sources = [
    "browser/enterprise/teleport_inplace_enrollment_sequence_unittest.cc",
    "browser/enterprise/teleport_tunnel_logic_unittest.cc",
    "browser/teleport_startup_unittest.cc",
    "common/teleport_channel_unittest.cc",
    "common/teleport_enroll_logic_unittest.cc",
    "common/teleport_deployment_config_unittest.cc",
    "common/teleport_domain_migration_unittest.cc",
    "common/teleport_enrollment_gate_logic_unittest.cc",
    "common/teleport_signin_entry_logic_unittest.cc",
    "common/teleport_enterprise_enrollment_unittest.cc",
    "common/teleport_enterprise_urls_unittest.cc",
    "common/teleport_feed_url_unittest.cc",
    "common/teleport_url_scheme_unittest.cc",
    "common/teleport_version_unittest.cc",
    "common/server_identity_proto_smoke_unittest.cc",
    "common/teleport_server_identity_unittest.cc",
    "common/teleport_server_identity_joint_unittest.cc",
    "common/teleport_server_identity_entry_unittest.cc",
  ]
  deps = [
    ":teleport",
    ":teleport_deployment_config",
    # teleport_deployment_config_unittest.cc includes the buildflag header to
    # assert the baked dev/release default-domain selection.
    ":teleport_policy_buildflags",
    ":server_identity_proto",
    ":teleport_server_identity",
    # teleport_tunnel_logic_unittest.cc tests the pure routing/config free
    # functions; //net for the net::ProxyServer/ProxyConfig/HttpRequestHeaders
    # types it inspects (network mojom comes transitively via the logic target).
    ":teleport_tunnel_logic",
    "//base/test:run_all_unittests",
    "//crypto",
    "//net",
    "//testing/gtest",
    "//url",
  ]

  # The Sparkle-backed user driver only exists when the updater is enabled, and
  # its header pulls <Sparkle/Sparkle.h>. Build its test only in that config,
  # mirroring the source_set's framework wiring: framework_dirs gives -F for the
  # .mm compile + link, and an rpath lets the standalone test binary find
  # Sparkle.framework in the checkout at runtime (the source_set's
  # @loader_path/../../.. rpath only resolves for the chrome framework's nesting).
  if (is_mac && teleport_enable_updater) {
    sources += [ "browser/mac/teleport_sparkle_user_driver_unittest.mm" ]
    deps += [ "//base/test:test_support" ]
    framework_dirs = [ teleport_sparkle_dir ]
    ldflags = [ "-Wl,-rpath,@loader_path/" +
                rebase_path(teleport_sparkle_dir, root_build_dir) ]
  }
}
