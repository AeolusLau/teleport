# Build args/paths for the //teleport overlay, kept in a .gni so upstream
# BUILD.gn files (e.g. //chrome) can import and reference them — a build arg
# is only in scope in files that declare it or import its declaration.

declare_args() {
  # Enable the Sparkle-based auto-updater. On for official channel builds
  # (release.mac.gn); off for dev so the dev workflow needs no framework/signing.
  teleport_enable_updater = false

  # Select the release vs. dev set of baked enterprise endpoints. This one
  # switch governs every dev/release-split constant: the policy verification
  # root public key (cloud_policy_constants.cc), the default device-management
  # server URL (browser_policy_connector.cc), and the enroll / register-handler
  # URLs (common/teleport_enterprise_urls.cc).
  # false (default / dev.mac.gn): dev values — fairyland.io endpoints +
  #   kDevPolicyKey (dev root-signer); safe for local testing and CI.
  # true (release.mac.gn): release values — beansec.com endpoints +
  #   kReleasePolicyKey (production KMS root); all release channels
  #   (canary/beta/stable) share one release binary.
  teleport_use_release_endpoints = false

  # Safety interlock for the release policy verification root key. kReleasePolicyKey
  # in cloud_policy_constants.cc is currently a THROWAWAY PLACEHOLDER; a release
  # build must not ship it (a leaked placeholder private key would validate forged
  # policy, and real KMS-signed policy would fail validation). Flip this to true
  # ONLY after kReleasePolicyKey + kPolicyVerificationKeyHash are replaced with the
  # real production KMS root. The assert below blocks any release-endpoints build
  # until then.
  teleport_release_policy_key_is_real = false
}

# A build that bakes the release endpoints must also bake the real release policy
# root key — never the placeholder. Keep this fail-closed.
assert(
    !teleport_use_release_endpoints || teleport_release_policy_key_is_real,
    "teleport_use_release_endpoints=true requires teleport_release_policy_key_is_real=true: kReleasePolicyKey is still a placeholder; set the real production KMS root key first.")

# Inside-checkout dir where fetch_sparkle.py symlinks the pinned framework.
teleport_sparkle_dir = "//third_party/teleport_sparkle"
