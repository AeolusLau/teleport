# Chromium checkout (managed by depot_tools / gclient)
/chromium

# Build outputs (build/ is a symlink -> chromium/src/out; no trailing slash so the symlink is ignored too)
/build

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

.claude

# Local release config (holds feed token / signing identity)
/scripts/release_config.local.toml

# Local packaging staging output
/dist
