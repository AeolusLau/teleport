+void ProfilePickerFlowController::SwitchToEnrollment(
+    Profile* profile,
+    StepSwitchFinishedCallback switch_finished_callback) {
+  DCHECK_EQ(Step::kProfilePicker, current_step());
+
+  if (IsStepInitialized(Step::kTeleportEnrollment)) {
+    UnregisterStep(Step::kTeleportEnrollment);
+  }
+
+  // The on-enrolled closure is moved into the step's WebContents UserData, taken
+  // by the OIDC throttle, and run async by the in-place registrar. Binding to a
+  // WeakPtr makes a destroyed flow controller a safe no-op. The provider holds a
+  // ScopedProfileKeepAlive on `profile` (and the registrar holds its own), so a
+  // live flow controller implies a live profile when the callback runs.
+  RegisterStep(
+      Step::kTeleportEnrollment,
+      CreateTeleportEnrollmentStep(
+          host(), profile,
+          base::BindOnce(&ProfilePickerFlowController::OnEnrollmentSucceeded,
+                         weak_ptr_factory_.GetWeakPtr(), profile)));
+
+  // teleport: unlike the generic CreateSwitchToStepPopCallback(current_step())
+  // used elsewhere (e.g. SwitchToReauth above), an explicit "back"/cancel out
+  // of the enrollment step needs a custom pop callback -- see
+  // PopTeleportEnrollmentStep() -- that also unregisters the step so a
+  // picker-added hidden profile's ScopedProfileKeepAlive is released (and thus
+  // deleted). This only fires on an explicit pop; enrollment failure keeps the
+  // step registered and shows an inline retry (TeleportEnrollmentProvider::
+  // OnEnrollmentFinished above), it does not pop.
+  SwitchToStep(
+      Step::kTeleportEnrollment, true, std::move(switch_finished_callback),
+      /*pop_step_callback=*/
+      base::BindOnce(&ProfilePickerFlowController::PopTeleportEnrollmentStep,
+                     base::Unretained(this)));
+}
+
+void ProfilePickerFlowController::PopTeleportEnrollmentStep() {
+  // teleport: pop callback for the enrollment step's "back"/cancel path (as
+  // opposed to enrollment failure, which stays on the step -- see
+  // TeleportEnrollmentProvider::OnEnrollmentFinished's inline error-page
+  // retry, and never runs this). Switch away from the step FIRST:
+  // UnregisterStep() CHECK_NE()s the step being removed against the currently
+  // tracked step, so kTeleportEnrollment must no longer be current before we
+  // unregister it. Unregistering destroys the TeleportEnrollmentStepController
+  // -> TeleportEnrollmentProvider, releasing its ScopedProfileKeepAlive; for a
+  // picker-added (ephemeral) profile that is the profile's last keep-alive and
+  // triggers automatic deletion of its directory, so an abandoned
+  // never-finalized enrollment (see OnEnrollmentSucceeded) never leaks a
+  // profile. The first profile is non-ephemeral, so this is a no-op deletion-
+  // wise for it; it can still reach this step via TryLaunchLockedProfile().
+  SwitchToStep(Step::kProfilePicker, /*reset_state=*/false);
+  UnregisterStep(Step::kTeleportEnrollment);
+}
+
+void ProfilePickerFlowController::OnEnrollmentSucceeded(Profile* profile) {
+  ProfileAttributesEntry* entry =
+      g_browser_process->profile_manager()
+          ->GetProfileAttributesStorage()
+          .GetProfileAttributesWithPath(profile->GetPath());
+
+  // teleport: a picker-added profile (see
+  // ProfilePickerHandler::OnNewProfileForEnrollmentCreated) is created hidden
+  // -- ephemeral + omitted -- so it is silently deleted at next startup if
+  // enrollment is never finished. On success, finalize it here (de-omit,
+  // de-ephemeral) so it survives restart instead. The first (auto-created,
+  // non-ephemeral) profile is never omitted, so it skips this block entirely
+  // and falls straight through to the unlock below -- unchanged from before.
+  //
+  // We deliberately do NOT call upstream FinalizeNewProfileSetup(): it
+  // CHECK(HasPrimaryAccount(kSync)) for non-managed accounts, which a
+  // dasherless (GAIA-free OIDC) profile never has -- it would crash here. We
+  // also skip its SetLocalProfileName() call: that renames the profile to a
+  // GAIA/account-resolved display name, which doesn't exist in this flow --
+  // the profile already carries the name chosen at creation time
+  // (CreateMultiProfileAsync's ChooseNameForNewProfile() call), and calling
+  // ChooseNameForNewProfile() again here would just collide with that same
+  // entry's own (already-taken) name and rename it to the next number for no
+  // reason, since GetAllProfilesAttributes() does not exclude omitted
+  // profiles.
+  if (entry->IsOmitted()) {
+    entry->SetIsOmitted(false);
+    if (!profile->GetPrefs()->GetBoolean(prefs::kForceEphemeralProfiles)) {
+      entry->SetIsEphemeral(false);
+    }
+  }
+
+  entry->LockForceSigninProfile(false);
+
+  FinishFlowAndRunInBrowser(profile, PostHostClearedCallback());
+}
