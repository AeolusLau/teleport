+void ProfilePickerFlowController::SwitchToEnrollment(
+    Profile* profile,
+    StepSwitchFinishedCallback switch_finished_callback) {
+  DCHECK_EQ(Step::kProfilePicker, current_step());
+
+  if (IsStepInitialized(Step::kTeleportEnrollment)) {
+    UnregisterStep(Step::kTeleportEnrollment);
+  }
+
+  // The on-enrolled closure is moved into the step's WebContents UserData, taken
+  // by the OIDC throttle, and run async by the in-place registrar. Binding to a
+  // WeakPtr makes a destroyed flow controller a safe no-op. The provider holds a
+  // ScopedProfileKeepAlive on `profile` (and the registrar holds its own), so a
+  // live flow controller implies a live profile when the callback runs.
+  RegisterStep(
+      Step::kTeleportEnrollment,
+      CreateTeleportEnrollmentStep(
+          host(), profile,
+          base::BindOnce(&ProfilePickerFlowController::OnEnrollmentSucceeded,
+                         weak_ptr_factory_.GetWeakPtr(), profile)));
+
+  SwitchToStep(
+      Step::kTeleportEnrollment, true, std::move(switch_finished_callback),
+      /*pop_step_callback=*/CreateSwitchToStepPopCallback(current_step()));
+}
+
+void ProfilePickerFlowController::OnEnrollmentSucceeded(Profile* profile) {
+  // The enrolled profile is an existing (non-omitted) profile; just unlock it.
+  // "Add profile" / new-profile creation is intentionally not supported here.
+  g_browser_process->profile_manager()
+      ->GetProfileAttributesStorage()
+      .GetProfileAttributesWithPath(profile->GetPath())
+      ->LockForceSigninProfile(false);
+
+  FinishFlowAndRunInBrowser(profile, PostHostClearedCallback());
+}
