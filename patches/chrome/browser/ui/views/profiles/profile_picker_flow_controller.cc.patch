+// teleport: GAIA-free enrollment provider. Hosts the enterprise OIDC enroll page
+// on the target (locked) profile's own WebContents and attaches an "enrollment
+// done" callback to it. There is NO ForceSigninVerifier, NO DiceTabHelper, NO
+// gaia_id/email handling: enrollment completion is detected and driven entirely
+// by the OIDC capture throttle -> in-place registrar, which runs the attached
+// callback (-> OnEnrollmentFinished) once the flow has a terminal result;
+// failures re-navigate to the enroll start page with an error banner.
+class TeleportEnrollmentProvider {
+ public:
+  TeleportEnrollmentProvider(ProfilePickerWebContentsHost* host,
+                             Profile* profile,
+                             base::OnceClosure on_enrolled)
+      : host_(host), profile_(profile), on_enrolled_(std::move(on_enrolled)) {}
+
+  TeleportEnrollmentProvider(const TeleportEnrollmentProvider&) = delete;
+  TeleportEnrollmentProvider& operator=(const TeleportEnrollmentProvider&) =
+      delete;
+  ~TeleportEnrollmentProvider() = default;
+
+  void Show(StepSwitchFinishedCallback step_shown_callback) {
+    CHECK(!contents_);
+    // Keep the locked profile alive for the duration of the picker-hosted flow.
+    profile_keep_alive_ = std::make_unique<ScopedProfileKeepAlive>(
+        profile_, ProfileKeepAliveOrigin::kProfileCreationFlow);
+
+    contents_ = content::WebContents::Create(
+        content::WebContents::CreateParams(profile_));
+    teleport::EnrollmentDoneUserData::Set(
+        contents_.get(),
+        base::BindOnce(&TeleportEnrollmentProvider::OnEnrollmentFinished,
+                       weak_factory_.GetWeakPtr()));
+    host_->ShowScreen(
+        contents_.get(), GURL(teleport::EnterpriseEnrollUrl()),
+        base::BindOnce(&ProfilePickerWebContentsHost::SetNativeToolbarVisible,
+                       base::Unretained(host_), /*visible=*/true)
+            .Then(base::BindOnce(std::move(step_shown_callback.value()),
+                                 /*success=*/true)));
+  }
+
+  content::WebContents* contents() { return contents_.get(); }
+
+  // Runs on the registrar's terminal outcome. Success hands off to the flow
+  // controller's unlock closure; failure keeps the gate locked and navigates
+  // the hosted enroll page to the server-rendered error banner (which is also
+  // the retry entry — the slug form restarts the whole flow).
+  void OnEnrollmentFinished(teleport::EnrollmentResult result) {
+    if (result == teleport::EnrollmentResult::kSuccess) {
+      // Run() can tear down this provider (FinishFlowAndRunInBrowser); return immediately.
+      std::move(on_enrolled_).Run();
+      return;
+    }
+    LOG(ERROR) << "[teleport-enroll] enrollment failed (result="
+               << static_cast<int>(result) << "); showing error page";
+    if (!contents_) {
+      return;
+    }
+    // Re-arm the outcome callback for the inline retry: the throttle consumed
+    // the previous one via Take() during the failed attempt, and the error
+    // page's slug form restarts the flow in this same WebContents.
+    teleport::EnrollmentDoneUserData::Set(
+        contents_.get(),
+        base::BindOnce(&TeleportEnrollmentProvider::OnEnrollmentFinished,
+                       weak_factory_.GetWeakPtr()));
+    content::NavigationController::LoadURLParams params(
+        teleport::EnrollmentErrorUrl(result));
+    params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+    contents_->GetController().LoadURLWithParams(params);
+  }
+
+ private:
+  raw_ptr<ProfilePickerWebContentsHost> host_;
+  raw_ptr<Profile> profile_;
+  base::OnceClosure on_enrolled_;
+  std::unique_ptr<ScopedProfileKeepAlive> profile_keep_alive_;
+  std::unique_ptr<content::WebContents> contents_;
+  base::WeakPtrFactory<TeleportEnrollmentProvider> weak_factory_{this};
+};
+
+class TeleportEnrollmentStepController : public ProfileManagementStepController {
+ public:
+  TeleportEnrollmentStepController(
+      ProfilePickerWebContentsHost* host,
+      std::unique_ptr<TeleportEnrollmentProvider> provider)
+      : ProfileManagementStepController(host),
+        enrollment_provider_(std::move(provider)) {}
+
+  ~TeleportEnrollmentStepController() override = default;
+
+  void Show(StepSwitchFinishedCallback step_shown_callback,
+            bool reset_state) override {
+    enrollment_provider_->Show(std::move(step_shown_callback));
+  }
+
+  void OnHidden() override { host()->SetNativeToolbarVisible(false); }
+
+  void OnNavigateBackRequested() override {
+    NavigateBackInternal(enrollment_provider_->contents());
+  }
+
+ private:
+  std::unique_ptr<TeleportEnrollmentProvider> enrollment_provider_;
+};
+
+std::unique_ptr<ProfileManagementStepController> CreateTeleportEnrollmentStep(
+    ProfilePickerWebContentsHost* host,
+    Profile* profile,
+    base::OnceClosure on_enrolled) {
+  return std::make_unique<TeleportEnrollmentStepController>(
+      host, std::make_unique<TeleportEnrollmentProvider>(
+                host, profile, std::move(on_enrolled)));
+}
