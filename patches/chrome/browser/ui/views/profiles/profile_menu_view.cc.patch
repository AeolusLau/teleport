+// teleport: click handler for the Teleport enrollment sign-in button set up in
+// GetIdentitySectionParams(). Mirrors every other handler in this file
+// (e.g. OnSigninButtonClicked() above): record the actionable-item click
+// first via OnActionableItemClicked() (this both logs the UMA bucket and is
+// what suppresses the post-close HaTS survey — see
+// ProfileMenuViewBase::OnClose()), bail out under the
+// set_perform_menu_actions_for_testing(false) test gate, then close-then-act.
+// kSigninButton is reused rather than adding a new ActionableItem value: it
+// is upstream's own "non-personalized signin button" bucket (no existing
+// account info attached), which is exactly this CTA's shape.
+void ProfileMenuView::OnTeleportSigninButtonClicked() {
+  OnActionableItemClicked(ActionableItem::kSigninButton);
+  if (!perform_menu_actions()) {
+    return;
+  }
+  GetWidget()->CloseWithReason(views::Widget::ClosedReason::kUnspecified);
+  teleport::OpenVoluntaryEnrollmentTab(&browser());
+}
