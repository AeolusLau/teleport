+# Teleport enroll page (teleport://enroll -> chrome://enroll). Its own target
+# so the growing fetch/verify/persist deps stay isolated from the config registry;
+# :configs deps this and includes teleport_enroll_ui.h to register the config.
+# Mojo interface for the enroll page (browser <-> chrome://enroll). Source
+# lives in the //teleport overlay; the target is here alongside the controller.
+mojom("teleport_enroll_mojo") {
+  sources = [ "//teleport/browser/webui/enroll.mojom" ]
+  public_deps = [ "//mojo/public/mojom/base" ]
+  webui_module_path = "/"
+}
+
+source_set("teleport_enroll") {
+  sources = [
+    "//teleport/browser/webui/teleport_enroll_ui.cc",
+    "//teleport/browser/webui/teleport_enroll_ui.h",
+  ]
+  deps = [
+    ":teleport_enroll_mojo",
+    "//base",
+    "//components/policy/core/common:common_constants",
+    "//content/public/browser",
+    "//content/public/common",
+    "//net",
+    "//services/network/public/cpp",
+    "//services/network/public/mojom",
+    "//teleport",
+    "//teleport/browser/resources/enroll:resources",
+    "//ui/webui",
+    "//url",
+  ]
+}
+
+# Teleport tunnel diagnostics page (teleport://tunnel -> chrome://tunnel).
+# Mojo interface for the tunnel page (browser <-> chrome://tunnel). Source
+# lives in the //teleport overlay; the target is here alongside the controller.
+mojom("teleport_tunnel_mojo") {
+  sources = [ "//teleport/browser/webui/tunnel.mojom" ]
+  public_deps = [ "//mojo/public/mojom/base" ]
+  webui_module_path = "/"
+}
+
+# NOTE: no //chrome/browser* dep, deliberately and structurally. :configs below
+# deps this target, and //chrome/browser:core deps :configs — so an edge from
+# here back to //chrome/browser:core closes a GN cycle, which plain `gn gen`
+# reports outright. This is NOT enforced by gn check: this tree does not pass
+# `gn check` today (pre-existing overlay violations, see
+# TD-OVERLAY-GN-CHECK-VIOLATIONS in docs/tech-debt.md), so the structure here is
+# the only thing holding the line. TeleportTunnelService is reached through the
+# //teleport callback seam in teleport_tunnel_logic.h instead.
+source_set("teleport_tunnel") {
+  sources = [
+    "//teleport/browser/webui/teleport_tunnel_ui.cc",
+    "//teleport/browser/webui/teleport_tunnel_ui.h",
+  ]
+  deps = [
+    ":teleport_tunnel_mojo",
+    "//base",
+    "//content/public/browser",
+    "//content/public/common",
+    "//teleport",
+    "//teleport/browser/resources/tunnel:resources",
+    "//ui/webui",
+    "//url",
+  ]
+}
+
