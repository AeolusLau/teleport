+# Teleport enroll page (teleport://enroll -> chrome://enroll). Its own target
+# so the growing fetch/verify/persist deps stay isolated from the config registry;
+# :configs deps this and includes teleport_enroll_ui.h to register the config.
+# Mojo interface for the enroll page (browser <-> chrome://enroll). Source
+# lives in the //teleport overlay; the target is here alongside the controller.
+mojom("teleport_enroll_mojo") {
+  sources = [ "//teleport/browser/webui/enroll.mojom" ]
+  public_deps = [ "//mojo/public/mojom/base" ]
+  webui_module_path = "/"
+}
+
+source_set("teleport_enroll") {
+  sources = [
+    "//teleport/browser/webui/teleport_enroll_ui.cc",
+    "//teleport/browser/webui/teleport_enroll_ui.h",
+  ]
+  deps = [
+    ":teleport_enroll_mojo",
+    "//base",
+    "//components/policy/core/common:common_constants",
+    "//content/public/browser",
+    "//content/public/common",
+    "//net",
+    "//services/network/public/cpp",
+    "//services/network/public/mojom",
+    "//teleport",
+    "//teleport/browser/resources/enroll:resources",
+    "//ui/webui",
+    "//url",
+  ]
+}
