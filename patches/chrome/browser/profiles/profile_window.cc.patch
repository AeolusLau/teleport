 void SwitchToGuestProfile(base::OnceCallback<void(Browser*)> callback) {
+  // teleport: IDC_OPEN_GUEST_PROFILE is unconditionally enabled upstream; block
+  // the action itself when guest is disabled (gate ON) rather than relying on
+  // hidden buttons.
+  if (!profiles::IsGuestModeEnabled()) {
+    return;
+  }
   SwitchToProfile(ProfileManager::GetGuestProfilePath(),
                   /*always_create=*/false, std::move(callback));
 }
