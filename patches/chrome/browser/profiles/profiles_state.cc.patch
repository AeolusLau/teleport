diff --git a/chrome/browser/profiles/profiles_state.cc b/chrome/browser/profiles/profiles_state.cc
index f7e623e42ac67..be555966f44c8 100644
--- a/chrome/browser/profiles/profiles_state.cc
+++ b/chrome/browser/profiles/profiles_state.cc
@@ -79,10 +79,21 @@ void RegisterPrefs(PrefRegistrySimple* registry) {
   registry->RegisterListPref(prefs::kProfilesDeleted);
 
   // Preferences about the user manager.
-  registry->RegisterBooleanPref(prefs::kBrowserGuestModeEnabled, true);
+  // teleport: Guest mode is DISABLED by default. A Guest profile is off-the-record
+  // and therefore invisible to the enrollment gate (ShouldGateProfile excludes OTR
+  // profiles); leaving Guest enabled would let a user click "Browse as Guest" from
+  // the force-signin-locked picker and reach the internet without enrolling. Add
+  // profile is also disabled by default (kBrowserAddPersonEnabled) so the picker
+  // hides the "add" tile — new-profile creation under mandatory enrollment is not
+  // supported. Tenants relax these via policy if they ever opt out.
+  registry->RegisterBooleanPref(prefs::kBrowserGuestModeEnabled, false);
   registry->RegisterBooleanPref(prefs::kBrowserGuestModeEnforced, false);
-  registry->RegisterBooleanPref(prefs::kBrowserAddPersonEnabled, true);
-  registry->RegisterBooleanPref(prefs::kForceBrowserSignin, false);
+  registry->RegisterBooleanPref(prefs::kBrowserAddPersonEnabled, false);
+  // teleport: force-signin defaults ON. A not-yet-enrolled profile is therefore
+  // locked at startup -> ProfilePicker (no browser window, no escape), where it
+  // is routed to the GAIA-free Teleport enrollment step. Tenants relax this via
+  // CBCM/Keystone if they ever opt out of mandatory enrollment.
+  registry->RegisterBooleanPref(prefs::kForceBrowserSignin, true);
   registry->RegisterBooleanPref(prefs::kBrowserShowProfilePickerOnStartup,
                                 true);
