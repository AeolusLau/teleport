+// PolicyFetchObserver ---------------------------------------------------------
+
+ChromeBrowserCloudManagementControllerDesktop::PolicyFetchObserver::
+    PolicyFetchObserver(MachineLevelUserCloudPolicyManager* manager)
+    : manager_(manager) {
+  manager_->AddClientObserver(this);
+  CloudPolicyCore* core = manager_->core();
+  CloudPolicyClient* client = core ? core->client() : nullptr;
+  // If the client already registered + fetched policy before we attached
+  // (StartInvalidations can run after the initial fetch), fetch now; otherwise
+  // OnPolicyFetched catches the upcoming fetch.
+  if (client && client->is_registered()) {
+    FetchRemoteCommands();
+  }
+}
+
+ChromeBrowserCloudManagementControllerDesktop::PolicyFetchObserver::
+    ~PolicyFetchObserver() {
+  manager_->RemoveClientObserver(this);
+}
+
+void ChromeBrowserCloudManagementControllerDesktop::PolicyFetchObserver::
+    OnPolicyFetched(CloudPolicyClient* /*client*/) {
+  FetchRemoteCommands();
+}
+
+void ChromeBrowserCloudManagementControllerDesktop::PolicyFetchObserver::
+    FetchRemoteCommands() {
+  // Teleport: post a delayed task so the fetch lands after the target Profile
+  // is loaded (executing synchronously here would cause CLEAR_BROWSING_DATA and
+  // similar commands to hit `if (!profile)` and return RESULT_FAILURE).
+  // RemoteCommandsService coalesces concurrent fetch requests, so overlapping
+  // delayed tasks from rapid policy fetches are safe.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PolicyFetchObserver::DoFetchRemoteCommands,
+                     weak_factory_.GetWeakPtr()),
+      base::Seconds(5));
+}
+
+void ChromeBrowserCloudManagementControllerDesktop::PolicyFetchObserver::
+    DoFetchRemoteCommands() {
+  // Teleport: no Google FCM channel, so RemoteCommandsInvalidator's
+  // InvalidationsExpected::kYes gate never fires. Fetch remote commands on
+  // every policy fetch (initial post-registration + every periodic refresh) to
+  // achieve poll parity: commands queued before launch are delivered on
+  // startup, and commands issued later on the next policy cycle.
+  // Delayed so the target profile is loaded before execution.
+  CloudPolicyCore* core = manager_->core();
+  if (RemoteCommandsService* rc_service =
+          core ? core->remote_commands_service() : nullptr) {
+    rc_service->FetchRemoteCommands(RemoteCommandsFetchReason::kStartup);
+  }
+}
