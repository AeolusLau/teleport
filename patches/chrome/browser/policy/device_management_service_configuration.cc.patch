 #if BUILDFLAG(IS_CHROMEOS)
 #include "chromeos/ash/components/system/statistics_provider.h"
@@ -41,12 +43,25 @@ DeviceManagementServiceConfiguration::~DeviceManagementServiceConfiguration() =
     default;
 
 std::string DeviceManagementServiceConfiguration::GetDMServerUrl() const {
-  return dm_server_url_;
+  // Teleport: resolve the deployment-domain-derived endpoint LAZILY. The value
+  // passed at construction is captured during ChromeBrowserPolicyConnector init,
+  // which runs before local_state finishes loading the user-accepted deployment
+  // domain — so teleport::DeploymentDomain() resolves to the baked default there
+  // and the wrong URL gets frozen for the process lifetime. An empty ctor value
+  // (see chrome_browser_policy_connector.cc) defers resolution to request time,
+  // when the user-accepted domain is available. A non-empty ctor value (tests /
+  // other callers) still wins.
+  return dm_server_url_.empty() ? teleport::DeploymentDeviceManagementServerUrl()
+                                : dm_server_url_;
 }
 
 std::string DeviceManagementServiceConfiguration::GetAgentParameter() const {
+  // Teleport: GetVersionNumber() is the product version; append the pinned
+  // Chromium engine version so the fairyland device-manager can persist and
+  // display both (management UI shows product + engine).
   return base::StrCat({version_info::GetProductName(), " ",
-                       version_info::GetVersionNumber(), "(",
+                       version_info::GetVersionNumber(),
+                       " Chromium/" TELEPORT_ENGINE_VERSION_STRING "(",
                        version_info::GetLastChange(), ")"});
 }
 
