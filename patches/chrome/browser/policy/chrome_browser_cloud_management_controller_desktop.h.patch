+  // so CanFetchRemoteCommands() is guaranteed true at that point.
+  class PolicyFetchObserver : public CloudPolicyClient::Observer {
+   public:
+    explicit PolicyFetchObserver(MachineLevelUserCloudPolicyManager* manager);
+    ~PolicyFetchObserver() override;
+
+    // CloudPolicyClient::Observer:
+    void OnPolicyFetched(CloudPolicyClient* client) override;
+
+   private:
+    // Posts a delayed task to call DoFetchRemoteCommands() (scheduler).
+    void FetchRemoteCommands();
+    // Actually fetches remote commands (runs after the delay, via WeakPtr).
+    void DoFetchRemoteCommands();
+
+    raw_ptr<MachineLevelUserCloudPolicyManager> manager_;
+
+    // Must be last: invalidates WeakPtrs before any other member is destroyed.
+    base::WeakPtrFactory<PolicyFetchObserver> weak_factory_{this};
+  };
