+void NetworkServiceProxyDelegate::OnBeforeForwardProxyRequest(
+    const net::ProxyChain& proxy_chain,
+    net::HttpRequestHeaders* extra_headers) {
+  // Mirror of OnBeforeTunnelRequest for the non-tunneled forward-proxy
+  // (http://) path: only inject the config's forward-proxy headers when the
+  // request is actually routed to a proxy in this config.
+  if (IsInProxyConfig(proxy_chain)) {
+    MergeRequestHeaders(extra_headers, proxy_config_->forward_proxy_headers);
+  }
+}
+
 base::expected<net::HttpRequestHeaders, net::Error>
 NetworkServiceProxyDelegate::OnBeforeTunnelRequest(
     const net::ProxyChain& proxy_chain,
@@ -169,15 +180,43 @@ NetworkServiceProxyDelegate::OnBeforeTunnelRequest(
   return extra_headers;
 }
 
+net::Error NetworkServiceProxyDelegate::OnTunnelHeadersReceivedForEndpoint(
+    const net::ProxyChain& proxy_chain,
+    size_t proxy_index,
+    const net::HostPortPair& endpoint,
+    const net::HttpResponseHeaders& response_headers,
+    net::CompletionOnceCallback callback) {
+  return NotifyTunnelHeadersReceived(proxy_chain, proxy_index, endpoint,
+                                     response_headers);
+}
+
 net::Error NetworkServiceProxyDelegate::OnTunnelHeadersReceived(
     const net::ProxyChain& proxy_chain,
     size_t proxy_index,
     const net::HttpResponseHeaders& response_headers,
     net::CompletionOnceCallback callback) {
+  // No destination to report: the only caller left on this overload is the
+  // CONNECT-UDP (MASQUE) socket, which holds none. Still notify, so that path
+  // is unchanged apart from an empty authority.
+  return NotifyTunnelHeadersReceived(proxy_chain, proxy_index,
+                                     net::HostPortPair(), response_headers);
+}
+
+net::Error NetworkServiceProxyDelegate::NotifyTunnelHeadersReceived(
+    const net::ProxyChain& proxy_chain,
+    size_t proxy_index,
+    const net::HostPortPair& endpoint,
+    const net::HttpResponseHeaders& response_headers) {
   if (observer_) {
+    // Deliberately NOT gated on IsInProxyConfig(), matching OnFallback and
+    // differing from the two header-writing methods above: an observer is told
+    // about every proxy chain and filters for itself (as
+    // PrefetchProxyConfigurator does). Adding a gate here would change what
+    // existing observers see.
+    //
     // Copy the response headers since mojo expects a ref counted object.
     observer_->OnTunnelHeadersReceived(
-        proxy_chain, proxy_index,
+        proxy_chain, proxy_index, endpoint,
         base::MakeRefCounted<net::HttpResponseHeaders>(
             response_headers.raw_headers()));
   }
