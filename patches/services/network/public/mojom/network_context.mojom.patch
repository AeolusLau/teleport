diff --git a/services/network/public/mojom/network_context.mojom b/services/network/public/mojom/network_context.mojom
index 09da137f59543..1b031e01d5222 100644
--- a/services/network/public/mojom/network_context.mojom
+++ b/services/network/public/mojom/network_context.mojom
@@ -136,6 +136,14 @@ struct CustomProxyConfig {
   // to the CONNECT request. Headers here will overwrite matching headers on
   // the CONNECT request if a custom proxy is used.
   HttpRequestHeaders connect_tunnel_headers;
+
+  // For non-tunneled forward-proxy requests (http://), these headers are added
+  // to the request sent to the proxy. Mirrors `connect_tunnel_headers`, which
+  // only covers the CONNECT/tunnel path: http:// backends reach the proxy as a
+  // plain forward-proxy request with no CONNECT, so they need this symmetric
+  // hook to carry proxy-destined headers (e.g. Proxy-Authorization). Headers
+  // here overwrite matching headers on the forward-proxy request.
+  HttpRequestHeaders forward_proxy_headers;
 };
 
 // Observer of custom proxy connections, especially for when errors occur.
@@ -147,9 +155,13 @@ interface CustomProxyConnectionObserver {
   OnFallback(ProxyChain bad_chain, int32 net_error);
 
   // Called when the response headers for the proxy tunnel request have been
-  // received.
+  // received. `endpoint` is the authority the CONNECT was issued for, which the
+  // proxy chain alone cannot report -- without it an observer can see that a
+  // tunnel failed but not which origin it failed for. It is empty for callers
+  // that hold no destination (CONNECT-UDP / MASQUE).
   OnTunnelHeadersReceived(ProxyChain proxy_chain,
                           uint64 chain_index,
+                          HostPortPair endpoint,
                           HttpResponseHeaders response_headers);
 };
 
