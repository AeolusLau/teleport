+// The endpoint-less overload is the one the CONNECT-UDP (MASQUE) call site
+// still uses. It must keep notifying -- just with an empty authority -- rather
+// than silently dropping the notification.
+TEST_F(NetworkServiceProxyDelegateTest,
+       OnTunnelHeadersReceivedWithoutEndpointStillObserved) {
+  net::ProxyChain proxy_chain(net::ProxyServer::SCHEME_HTTP,
+                              net::HostPortPair("proxy1.com", 80));
+  scoped_refptr<net::HttpResponseHeaders> headers =
+      base::MakeRefCounted<net::HttpResponseHeaders>(
+          "HTTP/1.1 200\nHello: World\n\n");
+
+  auto config = mojom::CustomProxyConfig::New();
+  config->rules.ParseFromString("http=foo");
+  auto delegate = CreateDelegate(std::move(config));
+
+  EXPECT_EQ(net::OK,
+            delegate->OnTunnelHeadersReceived(proxy_chain, /*chain_index=*/0,
+                                              *headers, base::DoNothing()));
+  RunUntilIdle();
+  ASSERT_TRUE(TestObserver()->HeadersReceivedArgs());
+  EXPECT_EQ(TestObserver()->HeadersReceivedArgs()->proxy_chain, proxy_chain);
+  EXPECT_TRUE(TestObserver()->HeadersReceivedArgs()->endpoint.IsEmpty());
+}
