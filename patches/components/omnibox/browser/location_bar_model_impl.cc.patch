diff --git a/components/omnibox/browser/location_bar_model_impl.cc b/components/omnibox/browser/location_bar_model_impl.cc
index 884e042c5a3df..29c6d913613df 100644
--- a/components/omnibox/browser/location_bar_model_impl.cc
+++ b/components/omnibox/browser/location_bar_model_impl.cc
@@ -108,6 +108,22 @@ std::u16string LocationBarModelImpl::GetFormattedURL(
 
   GURL url(GetURL());
 
+  // teleport overlay: display internal chrome:// pages as teleport:// (the
+  // Teleport-branded alias). Display-only — GetURL() (the actual address and
+  // security state) is unchanged. Scheme strings are literals here to avoid a
+  // components->content layering dependency; they mirror content::kChromeUIScheme
+  // and teleport::kTeleportScheme.
+  if (url.SchemeIs("chrome")) {
+    GURL::Replacements teleport_scheme;
+    teleport_scheme.SetSchemeStr("teleport");
+    // Present the chrome://chrome-urls directory under our brand host
+    // (teleport://teleport-urls). Literals kept in sync with //teleport.
+    if (url.host() == "chrome-urls") {
+      teleport_scheme.SetHostStr("teleport-urls");
+    }
+    url = url.ReplaceComponents(teleport_scheme);
+  }
+
 #if BUILDFLAG(IS_IOS)
   // On iOS, the blob: display URLs should be simply the domain name. However,
   // url_formatter parses everything past blob: as path, not domain, so swap
