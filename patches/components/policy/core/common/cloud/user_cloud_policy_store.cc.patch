+        // every recovery-endorsed cache stale and make every launch re-fetch --
+        // across every profile at once, right after a rotation, which is the
+        // worst possible moment to add load.
         doing_key_rotation = true;
         LOG_POLICY(WARNING, POLICY_PROCESSING)
             << PolicyTypeLogPrefix(policy_type(), std::string())
