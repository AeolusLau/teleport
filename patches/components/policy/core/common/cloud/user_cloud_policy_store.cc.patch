--- a/components/policy/core/common/cloud/user_cloud_policy_store.cc
+++ b/components/policy/core/common/cloud/user_cloud_policy_store.cc
@@ -261,10 +261,17 @@ void DesktopCloudPolicyStore::PolicyLoaded(bool validate_in_background,
 
       bool doing_key_rotation = result.doing_key_rotation;
       if (key && (!key->has_verification_key() ||
-                  key->verification_key() != GetPolicyVerificationKey())) {
-        // The cached key didn't match our current key, so we're doing a key
-        // rotation - make sure we request a new key from the server on our
-        // next fetch.
+                  !IsKnownVerificationKey(key->verification_key()))) {
+        // The cached key was endorsed by a root this build no longer trusts, so
+        // we're doing a key rotation - make sure we request a new key from the
+        // server on our next fetch.
+        //
+        // Membership, not equality with the primary: a release build trusts a
+        // primary and a dormant recovery root, and a cache endorsed by either
